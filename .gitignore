# Python
__pycache__/
*.py[cod]
*.pyd
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenv
.venv/
venv/
ENV/

# Logs / local outputs
output/
data_exports/
monitor_data/
config/autosave/
*.log
wandb/

# Studio runtime data (SQLite, user configs, task logs)
studio_data/

# Studio frontend (Node deps and build artifacts)
studio/web/node_modules/
studio/web/dist/
studio/web/.vite/

# Stray top-level node_modules (vitest / some tools may pull one at the repo root)
/node_modules/

# Studio now uses the preset pool (studio_data/presets/, already covered by the
# studio_data/ blanket rule); the old config/ directory is gone, so the user
# yaml exclusion rule is no longer needed.

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
.claude/

# Caches (HF/Transformers etc.)
**/.cache/


# Model weights (keep code/config, ignore large weights)
*.safetensors
*.ckpt
*.bin
*.pt
*.pth
*.npz
*.onnx
models/text_encoders/tokenizer.json
models/text_encoders/vocab.json
models/wd14/
models/taeflux/
models/cltagger/

# Dataset (training images)
dataset/

# Misc
nul
# Root-level AI agent files — gitignored so contributors can put personal
# config / @docs/AGENTS.md import here without conflicting with the repo.
# The project conventions live at docs/AGENTS.md (NOT ignored — note the leading /).
/AGENTS.md
/CLAUDE.md

# Local extracted design-mockup source directory (already organized into mockup/)
1/

# Temporary directory generated by tooling
.spec-workflow/

# Ephemeral flag used for self-update inter-process communication
# (server writes it -> cli.py / wrapper reads it and deletes it immediately)
tmp/

# Local documentation drafts (personal TODOs / unfinished designs / scratch notes)
docs/_local/

# Local UI snapshots before redesign (not for commit)
_ui_backup/

# Build output of the one-click launcher (produced by tools/build_launcher.py).
#
# `AnimaLoraStudio.exe` (Windows) is **deliberately not** in this list — it's
# committed alongside the repo so that after `git clone` a user can just
# double-click it, without first hunting for the attachment on Releases.
# It's built and committed back by .github/workflows/publish-launcher.yml on
# a windows runner.
#
# The non-Windows build output is still ignored: Linux/macOS users just run
# `./studio.sh` directly and don't need a bootstrapper, so committing it would
# only add a few extra MB for everyone to download.
/AnimaLoraStudio
/dist/

# Third-party library cache (pip / HuggingFace / torch / npm / ...) — see
# studio/infrastructure/local_cache.py: it's collected into the project
# folder by default so a few GB don't quietly pile up on the system drive.
# The whole directory can be deleted at any time; deleting it just means
# it gets re-downloaded next time.
/.cache/
